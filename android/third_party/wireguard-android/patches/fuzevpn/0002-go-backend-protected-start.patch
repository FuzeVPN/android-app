+//export wgSetConfig
+func wgSetConfig(tunnelHandle int32, settings string) int32 {
+	handle, ok := tunnelHandles[tunnelHandle]
+	if !ok {
+		return -1
+	}
+	// Callers install only peer UAPI fields here. In particular, a repeated
+	// listen_port would force BindUpdate and replace Android-protected sockets.
+	if !isPeerOnlyConfig(settings) {
+		return -1
+	}
+	if err := handle.device.IpcSet(settings); err != nil {
+		return -1
+	}
+	return 0
+}
+
+func isPeerOnlyConfig(settings string) bool {
+	for _, line := range strings.Split(settings, "\n") {
+		if strings.HasPrefix(line, "private_key=") ||
+			strings.HasPrefix(line, "listen_port=") ||
+			strings.HasPrefix(line, "fwmark=") {
+			return false
+		}
+	}
+	return true
+}
