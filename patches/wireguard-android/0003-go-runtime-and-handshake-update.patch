++++ b/src/runtime/time_linux_amd64.s
+@@ -56,7 +56,7 @@
+ 	JEQ	fallback
+ 	CALL	AX
+ 
+-	MOVL	$1, DI // CLOCK_MONOTONIC
++	MOVL	$7, DI // CLOCK_BOOTTIME
+ 	LEAQ	0(SP), SI
